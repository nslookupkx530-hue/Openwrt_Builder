#!/bin/bash
# ============= ImmortalWrt 25.12.x 第三方插件 APK =============
# ============= 若启用则取消对应 CUSTOM_PACKAGES 前面的注释 =============
# ============= 本文件本质上是 CUSTOM_PACKAGES 字符串的拼接 =============
#
# 第三方预编译 APK 来源：
# https://github.com/wukongdaily/apk
#
# 支持架构：
# x86
# arm64
# arm64-a53
#
# 注意：
# 1. 这些插件不是通过 feeds 源码编译，而是直接集成已经编译好的 APK
# 2. 构建系统会根据设备架构自动选择对应目录
# 3. 硬路由设备请根据闪存容量谨慎选择插件
# 4. 部分插件存在互相冲突的情况，请不要同时启用冲突插件

CUSTOM_PACKAGES=""

# ============================================================
# iStore / 首页和网络向导
# ============================================================

# iStore 商店
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-store"

# 首页和网络向导
# 注意：此插件依赖 iStore 商店
# 若集成 quickstart，则同时需要集成 luci-app-store
