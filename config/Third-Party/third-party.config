#!/bin/bash

# ============================================================
# OpenWrt 25.12.x Third Party Packages
#
# 支持：
#
# 1. 第三方源码 Feed
# 2. 第三方 APK Feed
#
# 当 workflow:
#
# third_party = enabled
#
# 自动加载此文件
#
# 默认启用：
#   iStore
#
# 其他插件：
#   删除对应配置前面的 #
# ============================================================


# ============================================================
# 初始化
# ============================================================

CUSTOM_SOURCE_FEEDS=""
CUSTOM_SOURCE_PACKAGES=""

CUSTOM_APK_FEEDS=""
CUSTOM_APK_PACKAGES=""


# ============================================================
# 第三方源码 Feed
# ============================================================


# ============================================================
# iStore
# ============================================================

CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
istore|https://github.com/linkease/istore.git|main"

CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
luci-app-store"



# ============================================================
# Run 安装器
# ============================================================
#
# https://github.com/wukongdaily/luci-app-run.git
#
# ============================================================


# CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
# run|https://github.com/wukongdaily/luci-app-run.git|main"

# CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
# luci-app-run"



# ============================================================
# QuickFile
# ============================================================
#
# https://github.com/sbwml/luci-app-quickfile.git
#
# 注意：
# quickfile 与 luci-app-run nginx 配置冲突
#
# 不建议同时启用
#
# ============================================================


# CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
# quickfile|https://github.com/sbwml/luci-app-quickfile.git|main"


# CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
# bash
# quickfile
# luci-app-quickfile
# luci-i18n-quickfile-zh-cn"



# ============================================================
# 第三方 APK Feed
# ============================================================
#
# 格式：
#
# 名称|packages.adb地址
#
# 示例：
#
# CUSTOM_APK_FEEDS="${CUSTOM_APK_FEEDS}
# repo-name|https://xxx/packages.adb"
#
# ============================================================


# CUSTOM_APK_FEEDS="${CUSTOM_APK_FEEDS}
# example|https://example.com/packages.adb"



# ============================================================
# 第三方 APK 软件包
# ============================================================
#
# 一个软件包一行
#
# ============================================================


# CUSTOM_APK_PACKAGES="${CUSTOM_APK_PACKAGES}
# xxx
# luci-app-xxx"



# ============================================================
# END
# ============================================================
