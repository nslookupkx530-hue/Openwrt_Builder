#!/bin/bash

# ============================================================
# ImmortalWrt 25.12.x 第三方 APK 插件配置
# ============================================================
#
# 第三方 APK 来源:
# https://github.com/wukongdaily/apk
#
# 支持架构:
#
#   x86
#   arm64
#   arm64-a53
#
# ============================================================
#
# 工作方式:
#
# CUSTOM_PACKAGES
#        ↓
# Prepare third-party APK packages
#        ↓
# 解包 .run
#        ↓
# 收集 APK
#        ↓
# 写入 rootfs APK 仓库
#
# 注意:
#
# 1. 这些插件不是 feeds 编译
# 2. 不会进入 make menuconfig
# 3. 不修改 .config
# 4. 固件首次启动由 apk 根据 world 文件安装
#
# ============================================================


CUSTOM_PACKAGES=""

CUSTOM_SOURCE_PACKAGES=""

CUSTOM_SOURCE_FEEDS=""



# ============================================================
# iStore 商店
# ============================================================

# iStore
#
# 提供:
# - iStore 软件中心
# - 插件管理
#
CUSTOM_PACKAGES="$CUSTOM_PACKAGES luci-app-store"



# ============================================================
# QuickStart 网络向导
# ============================================================

# 首页和网络向导
