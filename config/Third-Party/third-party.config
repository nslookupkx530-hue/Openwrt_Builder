#!/bin/bash

# ============================================================
# 25.12.x第三方插件配置
#
# 支持：
#   1. 第三方源码 Feed
#   2. 第三方 APK Feed
#
# 当third-party packages开关为：【Enable】 默认安装iStore应用商店
# 需要使用某个插件时，取消对应配置行前面的 #
# ============================================================


# ============================================================
# 初始化
# ============================================================

CUSTOM_SOURCE_FEEDS=""
CUSTOM_SOURCE_PACKAGES=""

CUSTOM_APK_FEEDS=""
CUSTOM_APK_PACKAGES=""


# ============================================================
# 第三方源码插件
# ============================================================


# ------------------------------------------------------------
# iStore
# ------------------------------------------------------------
#
# 官方源码：
# https://github.com/linkease/istore.git
#
# iStore 官方支持通过 OpenWrt Feed 集成：
# luci-app-store
#
# ------------------------------------------------------------

CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
istore|https://github.com/linkease/istore.git|main"

CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
luci-app-store"


# ------------------------------------------------------------
# Run 安装器
# ------------------------------------------------------------
#
# 官方仓库：
# https://github.com/wukongdaily/luci-app-run.git
#
# 用于快速安装makeself打包的run文件
#
# 目前和quickfile的nginx配置冲突 请勿同时集成quickfile
# ------------------------------------------------------------

# CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
# run|https://github.com/wukongdaily/luci-app-run.git|main"

# CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
# luci-app-run"


# ------------------------------------------------------------
# QuickFile
# ------------------------------------------------------------
#
# 官方仓库：
# https://github.com/sbwml/luci-app-quickfile.git
#
# QuickFile 需要 nginx 配合使用。
# 官方 README 也特别提示了 nginx 相关配置要求。
#
# ------------------------------------------------------------

# CUSTOM_SOURCE_FEEDS="${CUSTOM_SOURCE_FEEDS}
# quickfile|https://github.com/sbwml/luci-app-quickfile.git|main"

# CUSTOM_SOURCE_PACKAGES="${CUSTOM_SOURCE_PACKAGES}
# bash
# quickfile
# luci-app-quickfile
# luci-i18n-quickfile-zh-cn"


# ============================================================
# 第三方 APK Feed
# ============================================================
#
# 格式：
#
# CUSTOM_APK_FEEDS="${CUSTOM_APK_FEEDS}
# 仓库名称|packages.adb完整地址"
#
# 例如：
#
# CUSTOM_APK_FEEDS="${CUSTOM_APK_FEEDS}
# myrepo|https://example.com/packages.adb"
#
# ============================================================


# ------------------------------------------------------------
# 示例 APK Feed
# ------------------------------------------------------------

# CUSTOM_APK_FEEDS="${CUSTOM_APK_FEEDS}
# myrepo|https://example.com/packages.adb"


# ------------------------------------------------------------
# 第三方 APK 软件包
# ------------------------------------------------------------
#
# 一个软件包一行。
#
# ------------------------------------------------------------

# CUSTOM_APK_PACKAGES="${CUSTOM_APK_PACKAGES}
# xxx
# luci-app-xxx"


# ============================================================
# 配置结束
# ============================================================
