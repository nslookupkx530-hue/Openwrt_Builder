#!/bin/sh

echo "=========================================="
echo "Install third-party APK packages"
echo "=========================================="


[ -f /etc/third-party-packages ] || exit 0


APK_REPO="/usr/share/third-party"


if [ ! -f "${APK_REPO}/packages.adb" ]; then

    echo "Missing third-party APK repository"

    exit 1

fi


mkdir -p /etc/apk/repositories.d


echo "file://${APK_REPO}/packages.adb" \
> /etc/apk/repositories.d/third-party.list


apk update


while read -r pkg
do

    [ -z "$pkg" ] && continue


    echo "Install ${pkg}"


    apk add \
        --allow-untrusted \
        "$pkg"


done < /etc/third-party-packages


exit 0
