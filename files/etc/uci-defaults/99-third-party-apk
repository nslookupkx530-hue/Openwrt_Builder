#!/bin/sh

echo "=========================================="
echo "Install third-party APK packages"
echo "=========================================="


APK_REPO="/usr/share/third-party"


if [ ! -f /etc/third-party-packages ]; then
    echo "No third-party packages"
    exit 0
fi


mkdir -p /etc/apk/repositories.d


cat > /etc/apk/repositories.d/third-party.list <<EOF
file://${APK_REPO}
EOF


apk update


while read -r pkg
do

    [ -z "$pkg" ] && continue

    apk add "$pkg"

done < /etc/third-party-packages


exit 0
