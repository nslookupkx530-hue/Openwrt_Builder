#!/bin/sh

echo "=========================================="
echo "Install third-party APK packages"
echo "=========================================="

if [ ! -f /etc/third-party-packages ]; then
    echo "No third-party package list"
    exit 0
fi


APK_DIR="/usr/share/third-party"


if [ ! -d "$APK_DIR" ]; then
    echo "Missing APK repository"
    exit 1
fi


mkdir -p /etc/apk/repositories.d


echo "file://$APK_DIR" \
> /etc/apk/repositories.d/third-party.list


apk update


while read -r pkg
do

    [ -z "$pkg" ] && continue

    echo "Install $pkg"

    apk add \
        --allow-untrusted \
        "$pkg"

done < /etc/third-party-packages


echo "Third-party APK installation completed"

exit 0
